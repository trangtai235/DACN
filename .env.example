DJANGO_SECRET_KEY=generate-with-scripts-setup-env
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_HOST=db
DB_PORT=5432
DB_NAME=annotaflow
DB_USER=annotaflow_app
DB_PASSWORD=generate-with-scripts-setup-env
DB_SSLMODE=prefer
DEMO_PASSWORD=generate-with-scripts-setup-env
COOKIE_SECURE=0
REDIS_URL=redis://redis:6379/0
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_PRICE=0
GEMINI_OUTPUT_PRICE=0
YOUTUBE_API_KEY=

# Studio v3 — native runner or Docker Celery
JOB_RUNNER=celery
AI_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,api.openai.com,generativelanguage.googleapis.com
SITE_URL=http://127.0.0.1:8000
REQUIRE_EMAIL_VERIFICATION=0
# Local emails are files. Use SMTP only after configuring the following fields.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=annotaflow@example.test
